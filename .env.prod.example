# Production env contract for the backend image (server + worker read the same vars).
# This is a TEMPLATE — copy into the deploy repo's `.env` and fill real secrets there.
# Every value is read in packages/backend/src/config.ts. Do NOT commit real secrets.

# --- HTTP server ---
HOST=0.0.0.0
PORT=3000

# --- Database (DigitalOcean Managed Postgres) ---
# Use the PRIVATE VPC host when the droplet and DB share a region/VPC.
DB_HOST=private-db-xxxxx.b.db.ondigitalocean.com
DB_PORT=25060
DB_USER=billing
DB_PASSWORD=__set_in_deploy_repo__
DB_NAME=billing
# Managed Postgres refuses plaintext. `require` = encrypt without CA verification
# (fine over the private VPC). Use `verify-full` + DB_CA_CERT to validate the chain.
DB_SSL=require
# DB_CA_CERT=-----BEGIN CERTIFICATE-----\n...   # only for DB_SSL=verify-full

# --- Auth ---
# Bootstrap admin credential (hash-verified, never stored). Set a strong random value,
# mint an Admin auth-token once, then you may remove this from the environment.
ADMIN_TOKEN=__set_in_deploy_repo__
SESSION_TTL_SECONDS=86400

# --- BFF gate ---
# Shared secret the Cloudflare Pages Function sends as `x-bff-secret`. MUST equal the
# Pages project's BFF_SECRET. Empty disables the gate (dev only) — always set in prod.
BFF_SECRET=__set_in_deploy_repo__

# --- WayForPay (single public host: bill.nexttick.it) ---
W4P_MERCHANT_ACCOUNT=__prod_merchant__
W4P_SECRET_KEY=__prod_secret__
W4P_MERCHANT_PASSWORD=__prod_regular_api_password__
W4P_DOMAIN_NAME=bill.nexttick.it
W4P_CHECKOUT_URL=https://secure.wayforpay.com/pay
W4P_SERVICE_URL=https://bill.nexttick.it/api/providers/wayforpay/callback
W4P_RETURN_URL=https://bill.nexttick.it/checkout/{orderReference}/return
W4P_RATE_LIMIT_RPS=2
W4P_SESSION_TTL_SECONDS=3600

# --- Gated OFF until production WayForPay access lands (CLAUDE.md §8/§13) ---
SCHEDULER_ENABLED=false
W4P_POLLER_ENABLED=false

# --- Process topology ---
# false (default): the API server and the queue worker are SEPARATE processes
# (compose runs `server` = main.js and `worker` = worker.js). true: the API server
# ALSO boots the queue worker in-process, so a single container serves the API and
# drains the queue (drop the separate `worker` service). Same image either way.
WORKER_ENABLED=false

# --- Worker queue tuning (optional; defaults shown) ---
# QUEUE_POLL_INTERVAL_MS=1000
# QUEUE_BATCH_SIZE=10
# QUEUE_VISIBILITY_TIMEOUT_MS=300000
# QUEUE_MAX_ATTEMPTS=5
