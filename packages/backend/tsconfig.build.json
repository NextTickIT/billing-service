{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "references": [{ "path": "../shared/tsconfig.build.json" }],
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/test/**"]
}
