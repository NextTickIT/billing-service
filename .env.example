# Copy to .env for local development.
# The DB host is a project-specific loopback (see README) so ports never
# clash with other projects bound to 127.0.0.1.

HOST=0.0.0.0
PORT=3000

DB_HOST=billing-service.local
DB_PORT=5432
DB_USER=billing
DB_PASSWORD=billing
DB_NAME=billing

# Auth module. ADMIN_TOKEN is the bootstrap admin credential presented as
# `Authorization: Bearer <ADMIN_TOKEN>` to create tokens/operators. It is
# hash-verified and NEVER stored in the database — set a strong random value.
ADMIN_TOKEN=change-me-dev-admin-token
# Session lifetime in seconds (default 24h).
SESSION_TTL_SECONDS=86400

# WhitePay (crypto acquiring). Needs THREE separate credentials — see docs/25 for
# where to get each in the WhitePay CRM. Leave WHITEPAY_ENABLED=false until all three
# are set: the adapter ships dark (no crypto method offered, callback inactive).
WHITEPAY_ENABLED=false
WHITEPAY_SLUG=
WHITEPAY_API_TOKEN=
WHITEPAY_WEBHOOK_TOKEN=
# WHITEPAY_API_URL=https://api.whitepay.com
