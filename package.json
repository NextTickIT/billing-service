{
  "name": "billing-service",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Billing-service monorepo (skeleton)",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "npm@10.9.7",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && prettier --check .",
    "lint:deps": "depcruise packages/backend/src --config .dependency-cruiser.cjs",
    "fix": "turbo run lint -- --fix && prettier --write .",
    "test": "turbo run test",
    "test:coverage": "turbo run build && vitest run --coverage",
    "test:mutation": "npm run test:mutation -w @billing-service/backend",
    "test:e2e": "npm run test:e2e -w @billing-service/backend",
    "test:ui": "npm run test:ui -w @billing-service/frontend",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "hooks:install": "git config core.hooksPath .githooks",
    "perf:smoke": "npm run perf:smoke -w @billing-service/backend",
    "review:ai": "scripts/ai-review.sh",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:test:up": "docker compose -f docker-compose.test.yml up -d",
    "db:test:down": "docker compose -f docker-compose.test.yml down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/autocannon": "^7.12.7",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^3.2.7",
    "autocannon": "^8.0.0",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^9.1.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.5",
    "tsc-alias": "^1.9.0",
    "tsx": "^4.23.0",
    "turbo": "^2.10.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.7"
  }
}
