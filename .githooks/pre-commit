#!/usr/bin/env bash
# Fast gate on what is about to be committed; the full suite runs in pre-push.
set -u

fail() {
  printf '\npre-commit: %s\nFix it, or bypass with --no-verify (reviewers will ask why).\n' "$1" >&2
  exit 1
}

if git diff --cached --quiet; then
  echo 'pre-commit: nothing staged, skipping.'
  exit 0
fi

# The checks below read the working tree, so the working tree must be exactly
# what is being committed for every source or config input: no unstaged edits
# to tracked files and no untracked files a staged file could depend on.
# Refusing is simpler and honest; stashing around the checks is not.
source_re='\.(ts|vue|js|cjs|mjs|json|css|yml|yaml)$'
dirty=()
while IFS= read -r -d '' entry; do
  path="${entry:3}"
  case "${entry:0:2}" in
    '??' | ?M | ?D | ?A) [[ "$path" =~ $source_re ]] && dirty+=("${entry:0:2} $path") ;;
  esac
done < <(git status --porcelain --untracked-files=all -z)
if [ "${#dirty[@]}" -gt 0 ]; then
  printf '  %s\n' "${dirty[@]}" >&2
  fail 'source files outside the index (unstaged edits or untracked); stage, stash or ignore them so the check sees exactly what will be committed'
fi

# NUL-separated so a path with spaces or tabs stays one argument.
staged=()
while IFS= read -r -d '' path; do staged+=("$path"); done \
  < <(git diff --cached --name-only --diff-filter=ACMR -z)

pretty=(); lintable=()
for path in "${staged[@]}"; do
  case "$path" in
    *.ts|*.vue) lintable+=("$path"); pretty+=("$path") ;;
    *.js|*.cjs|*.mjs|*.json|*.md|*.css|*.scss|*.html|*.yml|*.yaml) pretty+=("$path") ;;
  esac
done

if [ "${#pretty[@]}" -gt 0 ]; then
  echo 'pre-commit: prettier --check'
  npx prettier --check --ignore-unknown "${pretty[@]}" || fail 'formatting (run npm run format)'
fi

if [ "${#lintable[@]}" -gt 0 ]; then
  echo 'pre-commit: eslint'
  npx eslint "${lintable[@]}" || fail 'eslint'
fi

echo 'pre-commit: unit smoke (shared + backend)'
npm test -w @billing-service/shared || fail 'shared unit tests'
npm test -w @billing-service/backend || fail 'backend unit tests'
