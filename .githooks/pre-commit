#!/usr/bin/env bash
# Fast gate on what is about to be committed; the full suite runs in pre-push.
set -u

fail() {
  printf '\npre-commit: %s\nFix it, or bypass with --no-verify (reviewers will ask why).\n' "$1" >&2
  exit 1
}

if git diff --cached --quiet; then
  echo 'pre-commit: nothing staged, skipping.'
  exit 0
fi

# The checks below read the working tree, so the working tree must be exactly
# what is being committed: no unstaged edits to tracked files and no
# non-ignored untracked files at all, whatever their extension — a staged test
# can depend on any of them. Refusing is simple and honest; classifying inputs
# by extension or stashing around the checks is not.
dirty=()
entries=()
while IFS= read -r -d '' entry; do entries+=("$entry"); done \
  < <(git status --porcelain --untracked-files=all -z)
i=0
while [ "$i" -lt "${#entries[@]}" ]; do
  entry="${entries[$i]}"; i=$((i + 1))
  # A rename/copy record is followed by one extra NUL-terminated field: the
  # original path. Skip it so it is not read as a status line.
  case "${entry:0:1}" in R|C) i=$((i + 1)) ;; esac
  case "${entry:0:2}" in
    '??' | ?M | ?D | ?A | ?R | ?C | ?T | ?U | UU | AA | DD) dirty+=("$entry") ;;
  esac
done
if [ "${#dirty[@]}" -gt 0 ]; then
  printf '  %s\n' "${dirty[@]}" >&2
  fail 'the working tree differs from the index; stage, stash or ignore these so the check sees exactly what will be committed'
fi

# NUL-separated so a path with spaces or tabs stays one argument.
staged=()
while IFS= read -r -d '' path; do staged+=("$path"); done \
  < <(git diff --cached --name-only --diff-filter=ACMR -z)

pretty=(); lintable=()
for path in "${staged[@]}"; do
  case "$path" in
    *.ts|*.vue) lintable+=("$path"); pretty+=("$path") ;;
    *.js|*.cjs|*.mjs|*.json|*.md|*.css|*.scss|*.html|*.yml|*.yaml) pretty+=("$path") ;;
  esac
done

if [ "${#pretty[@]}" -gt 0 ]; then
  echo 'pre-commit: prettier --check'
  npx prettier --check --ignore-unknown "${pretty[@]}" || fail 'formatting (run npm run format)'
fi

if [ "${#lintable[@]}" -gt 0 ]; then
  echo 'pre-commit: eslint'
  npx eslint "${lintable[@]}" || fail 'eslint'
fi

# Through turbo so `test` runs after `^build`: a direct `npm test -w` would use
# whatever packages/shared/dist happens to be on disk.
echo 'pre-commit: unit smoke (shared + backend, via turbo)'
npx turbo run test --filter=@billing-service/shared --filter=@billing-service/backend ||
  fail 'unit tests'
