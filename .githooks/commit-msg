#!/bin/sh
# Conventional Commits keep the history greppable and changelog-ready.
set -u

# Git strips comment and blank lines after this hook runs, so judge the first
# line that will survive, not the raw first line of a template.
subject=$(grep -v '^#' "$1" | sed '/^[[:space:]]*$/d' | head -n 1)

case "$subject" in
  'Merge '* | 'Revert '* | 'fixup! '* | 'squash! '* | 'amend! '*) exit 0 ;;
esac

# The type list and the comma-separated multi-scope form (`fix(sinks,config): …`)
# come from this repository's own history, not from a generic preset.
types='feat|fix|chore|docs|test|refactor|harden|perf|build|ci|revert|style|diag'
pattern="^($types)(\([a-z0-9/_-]+(,[a-z0-9/_-]+)*\))?!?: .{1,100}\$"

if printf '%s\n' "$subject" | grep -Eq "$pattern"; then
  exit 0
fi

cat >&2 <<MSG
commit-msg: the first line is not a Conventional Commit:

  $subject

Expected:  <type>(<scope>)?!?: <summary up to 100 chars>
Types:     ${types}
Examples:  feat(checkout): add promo codes
           fix(billing)!: stop double retry on day 7
MSG
exit 1
